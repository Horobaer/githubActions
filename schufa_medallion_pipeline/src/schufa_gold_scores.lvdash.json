{
  "datasets": [
    {
      "name": "persons",
      "displayName": "Person Scores (Gold)",
      "queryLines": [
        "SELECT\n",
        "  person_id,\n",
        "  CONCAT(person_name, ' (', person_id, ')') AS person,\n",
        "  person_name,\n",
        "  city,\n",
        "  mock_score,\n",
        "  CASE WHEN mock_score >= 76 THEN '76-100 Good'\n",
        "       WHEN mock_score >= 51 THEN '51-75 Fair'\n",
        "       WHEN mock_score >= 26 THEN '26-50 Weak'\n",
        "       ELSE '0-25 Poor' END AS score_band,\n",
        "  last_event_at,\n",
        "  num_score_requests,\n",
        "  num_contracts,\n",
        "  num_late_payments,\n",
        "  num_defaults,\n",
        "  num_on_time_payments,\n",
        "  num_late_payments + num_defaults + num_on_time_payments AS num_payment_events,\n",
        "  num_score_requests + num_contracts + num_late_payments + num_defaults + num_on_time_payments AS num_events_captured,\n",
        "  PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY mock_score) OVER () AS median_score_all,\n",
        "  total_contract_amount\n",
        "FROM person_scores"
      ]
    },
    {
      "name": "event_mix",
      "displayName": "Event Mix by City and Score Band",
      "queryLines": [
        "WITH base AS (\n",
        "  SELECT city,\n",
        "    CASE WHEN mock_score >= 76 THEN '76-100 Good'\n",
        "         WHEN mock_score >= 51 THEN '51-75 Fair'\n",
        "         WHEN mock_score >= 26 THEN '26-50 Weak'\n",
        "         ELSE '0-25 Poor' END AS score_band,\n",
        "    num_score_requests, num_contracts, num_defaults, num_late_payments, num_on_time_payments\n",
        "  FROM person_scores\n",
        ")\n",
        "SELECT city, score_band, 'Score requests' AS event_type, SUM(num_score_requests) AS event_count FROM base GROUP BY city, score_band\n",
        "UNION ALL SELECT city, score_band, 'Contracts reported', SUM(num_contracts) FROM base GROUP BY city, score_band\n",
        "UNION ALL SELECT city, score_band, 'Payments', SUM(num_defaults + num_late_payments + num_on_time_payments) FROM base GROUP BY city, score_band\n",
        "UNION ALL SELECT city, score_band, 'On-time payments', SUM(num_on_time_payments) FROM base GROUP BY city, score_band\n",
        "UNION ALL SELECT city, score_band, 'Late payments', SUM(num_late_payments) FROM base GROUP BY city, score_band\n",
        "UNION ALL SELECT city, score_band, 'Defaults', SUM(num_defaults) FROM base GROUP BY city, score_band"
      ]
    }
  ],
